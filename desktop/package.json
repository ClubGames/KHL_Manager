{
  "name": "khl-gm-desktop",
  "productName": "Hockey Simulator Manager",
  "version": "1.0.0",
  "description": "Хоккейный Симулятор Менеджера – Hockey Simulator Manager, приложение для Windows",
  "author": "ClubGames",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-web": "node prepare.mjs",
    "start": "npm run prepare-web && electron .",
    "dist:win": "npm run prepare-web && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.clubgames.khlgm",
    "productName": "Hockey Simulator Manager",
    "executableName": "Hockey Simulator Manager",
    "copyright": "ClubGames",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.cjs", "preload.cjs", "modInstall.cjs", "app/**/*", "package.json"],
    "asar": true,
    "electronLanguages": ["ru", "en-US"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "language": "1049",
      "installerLanguages": ["ru_RU"],
      "multiLanguageInstaller": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Хоккейный Симулятор Менеджера",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "artifactName": "Hockey-Simulator-Manager-Setup.${ext}"
    },
    "portable": { "artifactName": "Hockey-Simulator-Manager-Portable.${ext}" }
  }
}
